--- a/train_net.py
+++ b/train_net.py
@@ -513,6 +513,35 @@ def main(args):
         DetectionCheckpointer(model, save_dir=cfg.OUTPUT_DIR).resume_or_load(
             cfg.MODEL.WEIGHTS, resume=args.resume
         )
+        # [baseline_failure D4/6] BF_ZERO_MODAL 이 있으면 해당 모달 입력 텐서를 0 으로
+        # 치환하는 forward pre-hook 을 건다(zero-out ablation). 모델 입력 dict 의 모달
+        # 키는 CAMERA·LIDAR·EVENT·DEPTH 이고 주 모달(RGB)은 image 키에도 중복 저장된다.
+        # CAMERA 를 0 으로 채울 때는 image 까지 함께 0 으로 채운다(두 키가 서로 다른
+        # 텐서를 가리킬 수 있으므로 둘 다 처리). 환경변수가 없으면 공식 경로 그대로.
+        _bf_zero = os.environ.get("BF_ZERO_MODAL")
+        if _bf_zero:
+            import torch as _bf_torch
+            _bf_modal = _bf_zero.strip().upper()
+            if _bf_modal not in ("CAMERA", "LIDAR", "EVENT", "DEPTH"):
+                raise ValueError(
+                    "BF_ZERO_MODAL 은 CAMERA|LIDAR|EVENT|DEPTH 중 하나여야 한다: "
+                    + str(_bf_zero))
+            _bf_keys = {_bf_modal}
+            if _bf_modal == "CAMERA":
+                _bf_keys.add("image")   # 주 모달 중복 저장 키(같은 텐서가 아닐 수 있음)
+
+            def _bf_zero_hook(_module, _inp):
+                bi = _inp[0]
+                if isinstance(bi, (list, tuple)):
+                    for d in bi:
+                        if isinstance(d, dict):
+                            for k in _bf_keys:
+                                v = d.get(k)
+                                if _bf_torch.is_tensor(v):
+                                    d[k] = _bf_torch.zeros_like(v)
+                return _inp
+            model.register_forward_pre_hook(_bf_zero_hook)
+            print(f"[baseline_failure] BF_ZERO_MODAL={_bf_zero} -> zero keys {sorted(_bf_keys)}")
         res = Trainer.test(cfg, model, eval_only=args.eval_only, inference_only=args.inference_only)
         if cfg.TEST.AUG.ENABLED:
             res.update(Trainer.test_with_TTA(cfg, model))
